# --- BLOG ---
export MYBLOG_DIR="$HOME/Documents/myblog"
alias blog="(cd $MYBLOG_DIR/content && $EDITOR posts)"
# alias blog_pub="cd $MYBLOG_DIR && hugo && rsync -vau --delete ~/Documents/myblog/public/ homelab.vpn:~/Services/nginx/nginx/html/myblog"

function post() {
  cd "$MYBLOG_DIR"
  output=$(hugo new "$1")
  file_path=$(echo "$output" | awk '{print $2}' | sed 's/"//g')
  if [ -n "$file_path" ]; then
      $EDITOR "$file_path"
  else
      echo "$output"
  fi
}

# --- Notes ---
export NOTE_DIR="/Users/zachlu/Library/Mobile Documents/iCloud~md~obsidian/Documents/MySecondBrain"
alias notes="(cd $NOTE_DIR && $EDITOR .)"
alias note="quick_note"

quick_note() {
    local note_dir="$NOTE_DIR/Inbox"
    
    # 处理参数
    local title="$1"
    local filename
    # local title
    
    if [ -n "$title" ]; then
        file_title="$title"
        # 生成文件名：时间戳+标题前10个字符（避免文件名冲突）
        # local base_name=$(echo "$title" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed 's/[^a-z0-9\u4e00-\u9fff]/-/g' | sed 's/-\+/-/g')
        local base_name=$(echo "$title" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' |  sed 's/-\+/-/g')
        filename="${base_name}.md"

        local counter=1
        local temp_filename="$filename"
        while [ -f "$note_dir/$temp_filename" ]; do
            temp_filename="${base_name}($counter).md"
            counter=$((counter + 1))
        done
        filename="$temp_filename"
    else
        # 默认使用时间戳
        filename=$(date +%Y%m%d%H%M%S).md
        title=""
    fi
    
    local filepath="$note_dir/$filename"
    
    # 创建临时文件作为 buffer 的初始内容
    local temp_content=$(mktemp)
    cat > "$temp_content" << EOF
---
date: $(date +"%Y-%m-%d")
tags: [inbox]
aliases: []
---

# $title

EOF

# 使用 nvim 编辑，但不自动保存
(cd "$note_dir" && nvim -c "0r $temp_content" \
                        -c "set ft=markdown"  \
                        -c "set modified"     \
                        -c "normal G"         \
                        -c "startinsert"      \
                        "$filename")

  # 清理临时文件
  rm -f "$temp_content"

  echo "$filepath"

}


