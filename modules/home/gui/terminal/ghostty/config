
# theme = "Atom"
theme = Hardcore
# theme = TokyoNight Night
font-family = "JetBrains Mono"
font-style = "Medium"
# font-style-bold = "Bold"
# font-style-italic = "Medium Italic"
# font-style-bold-italic = "Bold Italic"
font-size = 14

adjust-cell-height = 15%
adjust-font-baseline = -10%
# font-thicken

# 背景透明
background-opacity = 0.8
background-blur-radius = 64

# hide top bar
# macos-titlebar-style = hidden

# these are used by fzf in vim
keybind = ctrl+shift+v=ignore
keybind = ctrl+shift+s=ignore
keybind = ctrl+shift+t=ignore

# command + `
keybind = global:super+grave_accent=toggle_quick_terminal
keybind = alt+shift+p=ignore

quick-terminal-animation-duration = 2

title = " "
window-padding-x = 16,16
window-padding-y = 0

# 剪贴板
clipboard-read = allow
clipboard-write = allow

macos-titlebar-proxy-icon = hidden
macos-option-as-alt = left

# window-colorspace = display-p3
window-colorspace = srgb

macos-titlebar-proxy-icon = hidden

# App图标
# 透明图标
macos-icon = glass 
# 经典图标
# macos-icon = official 

keybind = shift+enter=text:\x1b\r

cursor-opacity = 1
# custom-shader = ./shaders/virtual_cursor.glsl

confirm-close-surface=false
